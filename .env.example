# 12-Factor Configuration for Blood Donor Connection Network
# Local Development & Container Environment Defaults

# Server Configuration
PORT=8000
FLASK_PORT=5000
ENV=development
DEBUG=True

# Database Configuration (Cloud SQL / PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_donor_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Security & Secrets
SECRET_KEY=dev-secret-key-arch-7525-bdcn
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
