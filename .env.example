# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_SECRET_KEY=super-secret-bdcn-key-12345
HOST=0.0.0.0
PORT=5000

# Database Configuration (ANSI SQL / SQLite / PostgreSQL)
DATABASE_URL=sqlite:///app.db
DATABASE_PATH=app.db
DB_POOL_SIZE=5

# Google Cloud Platform & Storage (GCP Backend CON-001)
GCP_PROJECT_ID=persistent-genai
GCS_BUCKET_NAME=persistent-genai-tf-state

# SLA and Automated Alert Configuration
REMINDER_THRESHOLD_HOURS=2.0
