# 12-Factor Environment Blueprint for Blood Donor Connection Network (BDCN)

# Server Configuration
PORT=8080
FLASK_ENV=production
FLASK_SECRET_KEY=bdcn-super-secret-key-change-in-production

# Relational Database Persistence (Cloud SQL / PostgreSQL or Local SQLite fallback)
DATABASE_URL=sqlite:///bdcn.db
# DATABASE_URL=postgresql://bdcn_user:bdcn_password@localhost:5432/bdcn_db

# Cache & Geospatial Hotspot Indexing (Redis Memorystore)
REDIS_URL=redis://localhost:6379/0

# Cloud Storage & Document Repository (GCP Cloud Storage)
GCS_BUCKET_NAME=persistent-genai-tf-state
GCS_DOCUMENT_FOLDER=medical_documents/

# Social Media OAuth Authentication
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
APPLE_CLIENT_ID=mock-apple-client-id
FACEBOOK_APP_ID=mock-facebook-app-id

# Notification & Dispatch Service
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_SMS_FALLBACK=true
