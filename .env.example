# BDCN Core Platform Environment Configuration
# 12-Factor Configuration Contract

# Flask Secret Key for session management
FLASK_SECRET_KEY=super-secret-bdcn-key-12345

# Server Port
PORT=5000

# Environment mode (production, development, testing)
FLASK_ENV=development

# Cloud SQL / PostgreSQL Database Connection String
DATABASE_URL=postgresql://bdcn_user:bdcn_password@localhost:5432/bdcn_db

# Memorystore / Redis Cache & PubSub Connection String
REDIS_URL=redis://localhost:6379/0
