# BDCN Emergency Blood Donor Connection Platform Environment Configuration
FLASK_SECRET_KEY=super-secret-bdcn-key-12345
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///db/bdcn.db
DB_POOL_SIZE=5

# Redis Cache / Message Broker
REDIS_URL=redis://localhost:6379/0

# Dispatch & Notification Settings
DISPATCH_PROXIMITY_RADIUS_KM=15.0
DISPATCH_LEAD_TIME_SLA_MINUTES=45
TESTING=false
