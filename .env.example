# Database Configuration
DATABASE_URL=sqlite:///bdcn.db
DB_POOL_SIZE=5

# Flask Server Configuration
FLASK_SECRET_KEY=super-secret-bdcn-key-12345
PORT=5000
FLASK_ENV=development

# Geolocation & H3 Spatial Resolution
H3_RESOLUTION=7
MAX_DISPATCH_RADIUS_KM=15

# Audit & Governance
AUDIT_LOG_ENABLED=true
