# ==========================================
# Blood Donor Connection Network (BDCN)
# 12-Factor Environment Configuration
# ==========================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_SECRET_KEY=dev-secret-key-bdcn-insecure-12345
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / PostGIS & SQLite fallback)
DATABASE_URL=postgresql://localhost:5432/bdcn_db
DATABASE_PATH=bdcn.db
DB_POOL_SIZE=10

# Redis Cache Configuration (Spatial Cluster & Hotspot Caching)
REDIS_URL=redis://localhost:6379/0

# Google Cloud Platform & Storage (CMEK Medical Audit Documents)
GCP_PROJECT_ID=persistent-genai
GCS_AUDIT_BUCKET=bdcn-medical-records-audit
GCS_CMEK_KEY_NAME=projects/persistent-genai/locations/global/keyRings/bdcn-ring/cryptoKeys/bdcn-cmek

# Social OAuth 2.0 Credentials
OAUTH_GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=mock-google-client-secret
OAUTH_APPLE_CLIENT_ID=mock.apple.client.id
OAUTH_FACEBOOK_APP_ID=mock-facebook-app-id
