# Blood Donor Connection Network (BDCN) Environment Configuration

# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=dev-secret-key-change-in-prod-12345
PORT=5000

# Database Configuration (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://bdcn_user:bdcn_password@localhost:5432/bdcn_db
DB_POOL_SIZE=10
DB_TIMEOUT_MS=2000

# In-Memory / SQLite Fallback for Local Unit Tests
USE_SQLITE_FALLBACK=1
SQLITE_DB_PATH=bdcn_local.db

# Redis Cache & Geospatial Store
REDIS_URL=redis://localhost:6379/0

# Security & HIPAA Cryptography (AES-256-GCM)
# 256-bit hex encoded encryption key (32 bytes)
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KMS_KEY_ID=projects/bdcn-healthcare/locations/global/keyRings/ephi-ring/cryptoKeys/national-id-key

# Push & SMS Gateway Credentials (Mocked/Local)
FCM_SERVER_KEY=mock-fcm-server-key
APNS_AUTH_TOKEN=mock-apns-token
TWILIO_ACCOUNT_SID=mock-twilio-sid
TWILIO_AUTH_TOKEN=mock-twilio-token
TWILIO_FROM_NUMBER=+15551234567
