# QuantumLeap Investment Portal Environment Configuration
# 12-Factor Compliant Environment Variables

# Application Secret Key
FLASK_SECRET_KEY=quantum-leap-secret-key-development-2026

# Database Configuration (defaults to local sqlite, support for PostgreSQL)
DATABASE_URL=sqlite:///quantum_leap.db

# Server Port
PORT=5000

# Environment Mode
FLASK_ENV=development
DEBUG=True
